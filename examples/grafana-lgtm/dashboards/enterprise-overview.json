  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 100,
      "title": "Pillar 1: Metrics - OpenShift & Java JVM Health",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "mimir" },
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line", "lineInterpolation": "smooth" },
          "unit": "percentunit"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 1 },
      "id": 1,
      "title": "JVM CPU Utilization vs CFS Quota",
      "targets": [
        {
          "expr": "sum(rate(container_cpu_usage_seconds_total{namespace=\"enterprise-workloads\"}[5m])) by (pod) / sum(container_spec_cpu_quota{namespace=\"enterprise-workloads\"}/container_spec_cpu_period{namespace=\"enterprise-workloads\"}) by (pod)",
          "legendFormat": "{{pod}} (CPU Utilization)"
        }
      ],
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "mimir" },
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line" },
          "unit": "short"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 1 },
      "id": 2,
      "title": "Apache Kafka Consumer Group Lag (records-lag-max)",
      "targets": [
        {
          "expr": "kafka_consumergroup_lag{topic=\"orders.events\"}",
          "legendFormat": "Lag on Partition {{partition}} (Group: {{consumergroup}})"
        }
      ],
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 9 },
      "id": 101,
      "title": "Pillar 2 & 3: Logs & Distributed Traces (Loki & Tempo)",
      "type": "row"
    },
    {
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 10 },
      "id": 3,
      "title": "Correlated Error Logs (MDC trace_id injected)",
      "targets": [
        {
          "expr": "{namespace=\"enterprise-workloads\"} |= \"ERROR\" | json",
          "legendFormat": "{{pod}} - {{level}}"
        }
      ],
      "type": "logs"
    },
    {
      "datasource": { "type": "tempo", "uid": "tempo" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 10 },
      "id": 4,
      "title": "Traced Transaction Latency (HTTP -> Kafka -> SQL Server)",
      "targets": [
        {
          "query": "status:error || duration > 1s",
          "queryType": "search"
        }
      ],
      "type": "traces"
    }
  ],
  "refresh": "10s",
